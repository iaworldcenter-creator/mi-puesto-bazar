                <label class="sr-only" for="siteSearch">¿Qué deseas buscar hoy?</label>
                <input aria-label="Buscar productos en el catálogo" autocomplete="off" class="flex-1 bg-transparent border-0 outline-none text-white font-bold text-xs px-4 placeholder-slate-500" id="siteSearch" name="q" placeholder="¿Qué producto, pieza o antojo buscas hoy? Escribe aquí..." type="text"/>
                <button aria-label="Buscar" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black px-6 py-1.5 rounded-full text-xs uppercase tracking-wider transition active:scale-95 shrink-0" type="submit">BUSCAR</button>
            </form>
        </div>

        <!-- Lado Derecho: Botón unificado del Carrito de Compras -->
