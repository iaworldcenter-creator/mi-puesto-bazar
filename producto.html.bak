        <div class="flex items-center gap-3 shrink-0">
            <img alt="Logo Oficial Anti-Gravity" class="w-11 h-11 rounded-full object-cover border-2 border-cyan-500 shadow-md" src="https://iaworldcenter-creator.github.io/pc-custom-lab/assets/img/mascota_tigre.webp"/>
